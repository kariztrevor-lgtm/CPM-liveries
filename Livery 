"use client"
import { useState } from 'react'
import { createClient } from '@/utils/supabase/client'

const THEMES = ['Drift','Police','Clean','Flashy','Anime','Matatu Vibes','Luxury','Gang / Clan','Stealth']
const CARS = ['Nissan GTR','BMW M4','Toyota Supra','Lamborghini Huracan','Audi RS7','Range Rover','Subaru WRX STI','Other']

export default function LiveryOrder(){
  const [form,setForm]=useState({name:'',cpm:'',car:'',theme:'Drift',colors:'',text:'',logo:'',refs:'',date:''})
  const [done,setDone]=useState(false)
  const supabase = createClient()

  const submit = async(e:any)=>{
    e.preventDefault()
    const {data,error} = await supabase.from('livery_orders').insert({
      name:form.name, cpm_username:form.cpm, car_model:form.car, design_theme:form.theme,
      colors:form.colors, car_text:form.text, clan_logo_url:form.logo,
      reference_urls:form.refs, delivery_by:form.date || null
    }).select().single()
    if(error) return alert(error.message)
    // Auto WhatsApp to you
    const msg = encodeURIComponent(`🔥 NEW LIVERY ORDER - LIVERY LAB KE\n\n1. Name: ${form.name}\nCPM: ${form.cpm}\n2. Car: ${form.car}\n3. Theme: ${form.theme}\n4. Colors: ${form.colors}\n5. Text: ${form.text}\n6. Logo: ${form.logo}\n7. Refs: ${form.refs}\n8. Delivery: ${form.date}\n\nOrder ID: ${data.id}`)
    window.open(`https://wa.me/254700000000?text=${msg}`,'_blank')
    setDone(true)
  }

  if(done) return <div className="max-w-xl mx-auto p-10 text-center"><div className="text-6xl">🔥</div><h1 className="text-4xl font-black mt-4">Order Received!</h1><p className="mt-2 text-zinc-500">Livery Lab KE will DM you on CPM / WhatsApp within 2 hours.</p><button onClick={()=>setDone(false)} className="mt-6 bg-black text-white px-6 py-3 rounded-full">New Order →</button></div>

  return (
    <main className="max-w-xl mx-auto p-6">
      <div className="flex justify-between items-center py-6"><b className="text-2xl font-black tracking-tighter">LIVERY LAB <span className="text-red-600">KE</span></b><span className="text-xs bg-black text-white px-3 py-1 rounded-full">CPM • KENYA</span></div>
      <h1 className="text-5xl font-black leading-[0.9]">Design your<br/><span className="text-red-600 italic">dream livery.</span></h1>
      <p className="text-zinc-500 mt-3">Fill in 30 seconds. We design, you flex.</p>

      <form onSubmit={submit} className="mt-8 space-y-5 bg-white border rounded-[24px] p-6 shadow-xl">
        <div><label className="text-xs font-bold">1. NAME / CPM USERNAME *</label><input required value={form.name} onChange={e=>setForm({...form, name:e.target.value})} placeholder="e.g. Kevin / @kevin_drifts" className="w-full h-12 border rounded-xl px-4 mt-1"/></div>
        <div><label className="text-xs font-bold">CPM USERNAME (if different)</label><input value={form.cpm} onChange={e=>setForm({...form, cpm:e.target.value})} placeholder="@..." className="w-full h-12 border rounded-xl px-4 mt-1"/></div>
        <div><label className="text-xs font-bold">2. CAR MODEL *</label><select value={form.car} onChange={e=>setForm({...form, car:e.target.value})} className="w-full h-12 border rounded-xl px-4 mt-1"><option value="">Select car...</option>{CARS.map(c=><option key={c}>{c}</option>)}</select><input placeholder="Or type your car..." onChange={e=>setForm({...form, car:e.target.value})} className="w-full h-12 border rounded-xl px-4 mt-2"/></div>
        <div><label className="text-xs font-bold">3. DESIGN THEME *</label><div className="flex flex-wrap gap-2 mt-2">{THEMES.map(t=><button type="button" key={t} onClick={()=>setForm({...form, theme:t})} className={`px-4 py-2 rounded-full text-sm border ${form.theme===t?'bg-black text-white':'bg-zinc-100'}`}>{t}</button>)}</div></div>
        <div><label className="text-xs font-bold">4. COLORS YOU WANT *</label><input required value={form.colors} onChange={e=>setForm({...form, colors:e.target.value})} placeholder="e.g. Black + Red + Gold" className="w-full h-12 border rounded-xl px-4 mt-1"/></div>
        <div><label className="text-xs font-bold">5. TEXT / NAME ON CAR</label><input value={form.text} onChange={e=>setForm({...form, text:e.target.value})} placeholder="e.g. KING KEV • ELDORET" className="w-full h-12 border rounded-xl px-4 mt-1"/></div>
        <div><label className="text-xs font-bold">6. CLAN LOGO? (paste image link)</label><input value={form.logo} onChange={e=>setForm({...form, logo:e.target.value})} placeholder="https://... or say 'Will send on WhatsApp'" className="w-full h-12 border rounded-xl px-4 mt-1"/></div>
        <div><label className="text-xs font-bold">7. REFERENCE PICTURES (links)</label><textarea value={form.refs} onChange={e=>setForm({...form, refs:e.target.value})} placeholder="Paste Instagram / Google Drive links..." className="w-full border rounded-xl p-4 mt-1" rows={2}/></div>
        <div><label className="text-xs font-bold">8. DELIVERY NEEDED BY</label><input type="date" value={form.date} onChange={e=>setForm({...form, date:e.target.value})} className="w-full h-12 border rounded-xl px-4 mt-1"/></div>
        <button className="w-full h-14 bg-red-600 text-white font-black rounded-full text-lg">🔥 SUBMIT ORDER → WHATSAPP</button>
        <p className="text-center text-xs text-zinc-400">Saved to Livery Lab KE database • No payment until design preview</p>
      </form>
    </main>
  )
}